# Speed NFC Backend - Server Environment Configuration

# 1. Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# 2. Supabase Configuration (PostgreSQL Data & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# 3. Resend Transactional Email Engine
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Speed NFC <onboarding@resend.dev>

# 4. Admin Concierge Notifications
ADMIN_EMAIL=concierge@speednfc.com
